# Python
__pycache__/
*.py[cod]
*.so
*.o

# C++ 扩展编译产物（需本地重新编译，避免提交绝对路径构建目录）
anydex_core/pointnet2/build/
anydex_core/knn/build/

# Python 构建分发产物
dist/
*.egg
*.egg-info/

# 模型权重：从 AnyDexGrasp 官方仓库下载（见 README）
logs/model/

# 静态大资源：Inspire 手 mesh/点云（9.7G，来自上游 AnyDexGrasp 仓库，不入库）
assets/inspire_urdf/

# 静态大资源：自研手 URDF（SolidWorks 导出的 STL mesh + urdf，体积大，不入库）
# 仅保留 .gitkeep 占位；文件改动需线下同步
assets/own_urdf/*
!assets/own_urdf/.gitkeep

# 标定图片一律不入库（体积大；poses.txt 与标定报告 json/txt 仍正常提交）
# 覆盖 calibration 下所有采集/复测目录（collect_data_*、rgb/、depth/ 等）及散图
# 例外：v2/ChArUco.jpeg 为标定板实物参考照（README 引用），正常提交
calibration/**/*.jpg
calibration/**/*.jpeg
calibration/**/*.png
!calibration/v2/ChArUco.jpeg
calibration/**/rgb/
calibration/**/depth/

# 编辑器
.idea/
.vscode/

# 日志/运行产物
*.log
